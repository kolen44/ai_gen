# ============================================================================
# ФИКСАЦИЯ ЛИЧНОСТИ (identity lock)
# ============================================================================
# Дописывается к промптам генерации по референсам (Seedream, NBP). Отдельно от STYLE_SUFFIX:
# стиль отвечает за то, КАК снято, этот блок — за то, КТО в кадре.
#
# Вторая половина блока (про разрешённую мимику) не менее важна первой: если оставить только
# запреты "не меняй лицо", модель копирует с референса и выражение тоже, и весь пак выходит
# с одним и тем же положением губ.
#
# Значение по умолчанию зашито в pipeline/prompt_config.py; раскомментируй, чтобы переопределить.
# IDENTITY_LOCK=preserve the exact same person from the reference image, facial identity must remain consistent, keep the same facial structure, proportions, eye shape and spacing, nose, lips, jawline, cheekbones, chin, hairline, skin tone and distinctive features, allow natural variation in expression and gaze, never change facial geometry, age, ethnicity or identity, no face morphing, no identity drift, no generic replacement face

# ============================================================================
# ВАРИАНТЫ МИМИКИ
# ============================================================================
# Раздаются кадрам по кругу, чтобы пак не вышел с одинаковым выражением.
# Пиши только выражение и взгляд — черты лица приходят из IDENTITY_LOCK.
# EXPRESSION_01=relaxed neutral expression, lips slightly parted
# EXPRESSION_02=soft closed-lip smile, warm eyes
# EXPRESSION_03=laughing openly, teeth visible, eyes crinkled
# EXPRESSION_04=thoughtful look, gazing away from the camera
# EXPRESSION_05=confident half-smile, chin slightly raised

# ============================================================================
# ПОРОГ NSFW-ГЕЙТА
# ============================================================================
# Настройка ФИЛЬТРА, а не генерации. Что рисуется — определяет промпт; порог решает только,
# забраковать ли уже готовый кадр. Выше значение = мягче отбор, а не «более откровенные кадры».
#
#   0.50  строгий SFW-профиль. Даёт ложные срабатывания на обычной fashion-съёмке:
#         открытые плечи, спина и купальник классификатор относит к откровенному.
#   0.85  рабочее значение для fashion/lifestyle (по умолчанию).
#   1.00  проверка фактически выключена. Score всё равно считается и пишется в лог.
#
# Возрастной гейт и сверка с watchlist этим параметром НЕ затрагиваются — они работают всегда.
NSFW_THRESHOLD=0.85

# ============================================================================
# НЕГАТИВНЫЙ ПРОМПТ
# ============================================================================
# Перекрывает LIFESTYLE_NEGATIVE_PROMPT из worker/config.py.
# Раскомментируй, только если понимаешь, что делаешь: в дефолтном уже собрано подавление
# ретуши и пластиковой кожи, без которого никакое "shot on iPhone" не помогает.
# NEGATIVE_PROMPT=(worst quality, low quality:1.3), airbrushed, smooth plastic skin, beauty filter, studio lighting, stock photo, waxy skin, bad anatomy, bad hands, extra digit, watermark, text

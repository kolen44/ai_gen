# Настройки пайплайна. Скопировать в .env и заполнить.
#
# Этот файл — единственный источник промптов и параметров: код своего текста не подмешивает.
# Правится через админку (python admin/app.py) или руками, формат обычный .env.
# Одна строка — одно значение, переводы строк внутри значения не поддерживаются.


# ============================================================
# КЛЮЧИ ДОСТУПА
# ============================================================
# RunPod: аренда GPU, создание и удаление подов. Нужен только для своей карты.
RUNPOD_API_KEY=
# HuggingFace: скачивание весов на под. Обязателен для gated-репозиториев (IP-Adapter FaceID).
HF_TOKEN=
# fal.ai: Seedream для картинок, Kling/Wan для видео, плюс хранилище файлов под ссылки.
# ВНИМАНИЕ: контент-чекер fal отклоняет обнажённый кадр на входе видео.
FAL_KEY=
# flaq.ai: Seedream для картинок и Wan 3.0 для видео. Контентных ограничений нет.
FLAQ_API_KEY=
# Google Gemini: Nano Banana Pro напрямую. Нужен только шагу сборки пака через nbp_build_pack.
GEMINI_API_KEY=


# ============================================================
# ПЕРСОНАЖ
# ============================================================
# Дописывается к КАЖДОМУ промпту. Не косметика: FaceID держит геометрию лица, но не цвет волос
# и не сложение — без этих полей кадр выходит с другими волосами, и косинус этого не замечает.
CHARACTER_NAME=nova
CHARACTER_AGE=30
CHARACTER_ETHNICITY=Eastern European
CHARACTER_HAIR=dark brown wavy shoulder-length hair
CHARACTER_EYES=hazel eyes
CHARACTER_FEATURES=small beauty mark above her left lip, fair skin
CHARACTER_BUILD=slim athletic build


# ============================================================
# НАСТРОЙКИ
# ============================================================
# Порог NSFW-фильтра ГОТОВОГО кадра. Это настройка фильтра, а не генерации: содержимое задаёт
# промпт, порог решает только, браковать ли результат. 1.0 = пропускать всё, но оценка всё равно
# считается и пишется в отчёт по каждому кадру. 0.5 — строго, на fashion-съёмке много ложных.
NSFW_THRESHOLD=1

# Возрастной гейт: оценка по лицу через InsightFace, а не документ. Оценщик шумный (на одном лице
# давал от 26 до 63), поэтому значение выше 18 работает как запас.
MIN_ALLOWED_AGE=18

# Как снято: камера, свет, фактура кожи. Дописывается в конец каждого промпта.
# Здесь не должно быть отрицаний ("no beauty filter") — CLIP их не понимает и рисует ровно то,
# что запрещают. Место отрицаний — в негативном промпте модели.
STYLE_SUFFIX=shot on iPhone, natural skin texture with visible pores, candid photo, slight grain

# Движение в ролике. Описывает, ЧТО делает персонаж, а не как выглядит.
VIDEO_PROMPT=she walks slowly and steadily toward the camera, smooth controlled stride, torso and shoulders stay stable, minimal bounce, hair moving gently with the motion, she looks into the lens and smiles softly, calm natural movement, steady camera, cinematic

# Фиксация лица текстом. Работает только там, где эталон подаётся КАРТИНКОЙ (flaq, Seedream).
# На своей карте не используется: там личность держат эмбеддинг и детейлер, а этот текст
# ссылался бы на несуществующий референс.
IDENTITY_LOCK=preserve the exact same person from the reference image, facial identity must remain consistent across every generation, keep the same facial structure, eye shape and spacing, nose shape, lips, jawline, cheekbones, skin tone and distinctive features, allow natural variation in facial expression and gaze direction


# ============================================================
# СЦЕНЫ — SCENE_01..NN
# ============================================================
# Что снимаем под ВИДЕО. Сплошная нумерация с 1, без пропусков.
# Кадр под ролик определяет всё, что в ролике окажется: видеомодель анимирует то, что видит.
SCENE_01=candid photo, sitting by a large window in a sunlit apartment, morning light across her face, medium shot
SCENE_02=candid street photo, walking past a shop window, late afternoon sun flare, mid-step, full body


# ============================================================
# ОБРАЗЫ — RESTYLE_01..NN
# ============================================================
# Что снимаем в ФОТОПАК, по кадру на образ.
# Внутри одного промпта не должно быть противоречий: "wearing a dress" вместе с "Clothing: none"
# модель разрешает как придётся, и часть кадров выходит одетой, часть нет.
RESTYLE_01=candid photo framed from the knees up, walking up a wide outdoor staircase caught mid-step, morning sun behind her, face turned toward the camera
RESTYLE_02=editorial photo framed from the knees up, walking past a tall sunlit window in a hotel room, sheer curtains drifting in the draught


# ============================================================
# МИМИКА — EXPRESSION_01..NN
# ============================================================
# Раздаётся кадрам по кругу. Должна быть в одном регистре с остальным промптом: "уставшая,
# глаза полузакрыты" рядом с "confident and calm gaze" — это спор, который гасит оба.
EXPRESSION_01=soft parted lips, relaxed sensual gaze straight into the lens
EXPRESSION_02=calm confident look, chin slightly lifted, mouth closed


# ============================================================
# ПОЗЫ — POSE_01..NN (необязательно)
# ============================================================
# Отдельный этап между паком и образами: тот же персонаж в позах под анимацию.
# Списка нет — этап пропускается целиком. Своего текста пайплайн не подставляет.


# ============================================================
# ВЫВОД
# ============================================================
# Куда складывать результаты всех прогонов. Пусто — runs/ внутри проекта.
OUTPUT_DIR=C:\Users\Admin\Downloads\Synthetic_Character_WIP
